# Unipile API (WhatsApp + Instagram)
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_DSN=your_unipile_dsn_here

# WhatsApp Account
UNIPILE_WHATSAPP_ACCOUNT_ID=your_whatsapp_account_id_here
UNIPILE_WHATSAPP_ENABLED=true

# Instagram Account
UNIPILE_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
UNIPILE_INSTAGRAM_ENABLED=true

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Calendar API
GOOGLE_CLIENT_EMAIL=your_google_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your_google_private_key_here
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Email Configuration (Gmail)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Server Configuration
PORT=3000
NODE_ENV=development

# Business Configuration
BUSINESS_NAME=ThePadelHouse
BUSINESS_PHONE=+90_xxx_xxx_xxxx
BUSINESS_EMAIL=info@thepadelhouse.com
BUSINESS_ADDRESS=Adres bilgisi
